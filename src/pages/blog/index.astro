---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups: { year: number; posts: typeof posts }[] = [];
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  const group = groups.find((g) => g.year === year);
  if (group) {
    group.posts.push(post);
  } else {
    groups.push({ year, posts: [post] });
  }
}
---

<BaseLayout title="Blog" description="Notes on infrastructure, incidents, and things I've built.">
  <h1>Blog</h1>
  <div class="prose">
    <p class="lede">Notes on infrastructure, incidents, and things I've built &mdash; written after the fact, not while I'm still panicking.</p>
  </div>

  {posts.length === 0 ? (
    <p class="note prose">No posts published yet &mdash; check back soon.</p>
  ) : (
    groups.map((group) => (
      <div class="year-group">
        <div class="year-heading">
          <h2>{group.year}</h2>
          <span class="tag-pill">{group.posts.length} post{group.posts.length === 1 ? '' : 's'}</span>
        </div>
        <ul class="entry-list">
          {group.posts.map((post) => (
            <li class="entry-row">
              <div class="entry-main">
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p class="entry-meta">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}
                </p>
              </div>
              {post.data.tags.length > 0 && (
                <div class="entry-tags">
                  {post.data.tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  )}
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const projects = await getCollection('projects');
const freelance = await getCollection('freelance');

const selectedWork = [
  ...projects.map((item) => ({ ...item, kind: 'project' as const })),
  ...freelance.map((item) => ({ ...item, kind: 'freelance' as const })),
]
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

function truncate(text: string, max = 130) {
  return text.length > max ? `${text.slice(0, max).trimEnd()}…` : text;
}
---

<BaseLayout title="Home">
  <section class="intro">
    <div class="intro-text">
      <h1>Hey, I'm Utkarsh!</h1>
      <p class="lede">
        A developer who works across infrastructure, architecture, and
        product development &mdash; with hands-on depth in DevOps and a
        growing focus on AI engineering.
      </p>
      <p>
        I help teams design reliable cloud infrastructure, build CI/CD
        pipelines that don't break under pressure, and ship practical
        AI-powered features &mdash; end to end, from architecture to
        deployment. This site is where I write about that work, keep a
        record of what I've built, and post the freelance projects I take on.
      </p>
      <p class="intro-cta">
        <a class="cta-primary" href="/contact/">Hire me for your project &rarr;</a>
        <a class="pill-link" href="/freelance/">See freelance work</a>
      </p>
    </div>
    <div class="intro-photo">
      <div class="intro-photo-circle">
        <img src="/images/utkarsh.jpg" alt="Utkarsh Thaokar" />
      </div>
    </div>
  </section>

  <hr />

  <section>
    <div class="section-heading">
      <h2>Latest posts</h2>
      <a class="pill-link" href="/blog/">All Posts</a>
    </div>
    <div class="prose">
      {posts.length === 0 ? (
        <p class="note">No posts published yet &mdash; check back soon.</p>
      ) : (
        <ul class="entry-list">
          {posts.map((post) => (
            <li>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p class="entry-meta">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <p class="entry-desc">{post.data.description}</p>
              <a class="read-more" href={`/blog/${post.id}/`}>Read more &rarr;</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <hr />

  <section>
    <div class="section-heading">
      <h2>Selected work</h2>
      <a class="pill-link" href="/projects/">All Projects</a>
      <a class="pill-link" href="/freelance/">All Freelance</a>
    </div>
    {selectedWork.length === 0 ? (
      <p class="note">Projects coming soon.</p>
    ) : (
      <div class="card-grid">
        {selectedWork.map((item) => (
          <div class="card">
            <p class="meta">{item.kind === 'freelance' ? 'Freelance' : 'Project'}</p>
            <h3>{item.data.title}</h3>
            <p>{truncate(item.data.description)}</p>
            <div class="card-links">
              {item.data.repo && <a href={item.data.repo} target="_blank" rel="noopener noreferrer">code</a>}
              {item.data.url && <a href={item.data.url} target="_blank" rel="noopener noreferrer">live</a>}
              {item.kind === 'freelance' && <a href={`/freelance/${item.id}/`}>Read more &rarr;</a>}
              {item.kind === 'project' && <a href={`/projects/${item.id}/`}>Read more &rarr;</a>}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

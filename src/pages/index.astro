---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const projects = await getCollection('projects');
const freelance = await getCollection('freelance');

const selectedWork = [
  ...projects.map((item) => ({ ...item, kind: 'project' as const })),
  ...freelance.map((item) => ({ ...item, kind: 'freelance' as const })),
]
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

function truncate(text: string, max = 130) {
  return text.length > max ? `${text.slice(0, max).trimEnd()}…` : text;
}
---

<BaseLayout title="Home">
  <section class="hero">
    <p class="hero-name">UTK</p>
    <p class="hero-tagline">
      DevOps &amp; Cloud Engineer in Pune, India, working across AWS and Azure &mdash;
      Terraform, CI/CD pipelines, Docker, and the occasional 2am disk-full incident.
      This is where I write about infrastructure, keep a record of what I've built,
      and post the freelance work I take on the side.
    </p>
  </section>

  <section>
    <h2>Latest posts</h2>
    <div class="prose">
      {posts.length === 0 ? (
        <p class="note">No posts published yet &mdash; check back soon.</p>
      ) : (
        <ul class="entry-list">
          {posts.map((post) => (
            <li>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p class="entry-meta">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <p class="entry-desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
      <p><a href="/blog/">View all posts &rarr;</a></p>
    </div>
  </section>

  <section>
    <h2>Selected work</h2>
    {selectedWork.length === 0 ? (
      <p class="note">Projects coming soon.</p>
    ) : (
      <div class="card-grid">
        {selectedWork.map((item) => (
          <div class="card">
            <p class="meta">{item.kind === 'freelance' ? 'Freelance' : 'Project'}</p>
            <h3>{item.data.title}</h3>
            <p>{truncate(item.data.description)}</p>
            <div class="card-links">
              {item.data.repo && <a href={item.data.repo} target="_blank" rel="noopener noreferrer">code</a>}
              {item.data.url && <a href={item.data.url} target="_blank" rel="noopener noreferrer">live</a>}
              {item.kind === 'freelance' && <a href={`/freelance/${item.id}/`}>details &rarr;</a>}
              {item.kind === 'project' && <a href={`/projects/${item.id}/`}>details &rarr;</a>}
            </div>
          </div>
        ))}
      </div>
    )}
    <p><a href="/projects/">View all projects &rarr;</a> &middot; <a href="/freelance/">Freelance work &rarr;</a></p>
  </section>
</BaseLayout>
